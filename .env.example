# Copy to /etc/psygridevents.env (or .env for local runs) and fill in. Never commit the real file.

# --- PSYGRID market data (required; no Dhan credentials are needed here) ---
# On the Oracle VM that also runs Psygrid use the loopback address:
PSYGRID_BASE_URL=http://127.0.0.1:10000
# shards (default, 22 bulk requests/min) or full (/public/live.json)
PSYGRID_FETCH_MODE=shards
PSYGRID_MAX_DATA_AGE_SECONDS=150

# --- Service ---
PSYGRIDEVENTS_DATA_DIR=/home/ubuntu/psygridevents/data
PSYGRIDEVENTS_API_HOST=127.0.0.1
PSYGRIDEVENTS_API_PORT=10100
# Required if API_HOST is not loopback: callers send ?token=... or "Authorization: Bearer ..."
PSYGRIDEVENTS_API_TOKEN=
PSYGRIDEVENTS_LOG_LEVEL=INFO
PSYGRIDEVENTS_LOG_JSON=1
# Honest identification for public sources (put a contact address here).
PSYGRIDEVENTS_USER_AGENT=PSYGRIDEVENTS/1.0 (+event-intelligence; contact: you@example.com)

# --- Signal policy (optional overrides of config/runtime.yaml) ---
PSYGRIDEVENTS_MIN_OPPORTUNITY_SCORE=60
PSYGRIDEVENTS_TOP_N=5

# --- Optional Telegram delivery (signal generation never depends on it) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional AI assist (off by default; pip install -e ".[ai]") ---
PSYGRIDEVENTS_AI_ENABLED=0
ANTHROPIC_API_KEY=
PSYGRIDEVENTS_AI_MAX_CALLS_PER_DAY=200
