[Unit]
Description=PSYGRIDEVENTS daily SQLite backup

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=APP_DIR=/home/ubuntu/psygridevents
ExecStart=/home/ubuntu/psygridevents/deploy/backup_db.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=psygridevents-backup
Nice=19
CPUWeight=10
IOSchedulingClass=idle
MemoryMax=300M
OOMScoreAdjust=900
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/psygridevents
